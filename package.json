{
    "name": "slaptax-mvp",
    "version": "0.1.0",
    "private": true,
    "description": "SLAPTAX MVP API server",
    "main": "api/server.js",
    "scripts": {
        "build": "npm --prefix web ci --include=dev && npm --prefix web run build",
        "start": "node api/server.js",
        "dev": "node api/server.js",
        "mat:refresh": "node api/scripts/importMatPuzzles.js",
        "test": "node --test api/tests/*.test.js",
        "build:all": "npm --prefix web run build:all",
        "mobile:sync": "npm --prefix web run mobile:sync",
        "mobile:check": "npm --prefix web run mobile:check"
    },
    "engines": {
        "node": ">=18"
    },
    "dependencies": {
        "chess.js": "^1.4.0",
        "csv-parse": "^7.0.2",
        "fzstd": "^0.1.1",
        "matter-js": "^0.20.0",
        "pg": "^8.21.0",
        "ws": "^8.21.0"
    }
}
